# Copy to .env.local for development. Every variable is validated in src/shared/env.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
EMBEDDINGS_API_KEY=
# scrypt hash of the admin password (format decided in the admin sign-in feature)
ADMIN_PASSWORD_HASH=
# at least 32 characters, used to encrypt the admin session cookie
SESSION_SECRET=
# absolute path OUTSIDE the deploy dir where cover images are stored
COVERS_DIR=./covers
